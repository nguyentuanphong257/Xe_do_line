extern volatile int16 pickup_timeout;
extern volatile int16 drop_timeout;
//MOTOR state
typedef enum Motor_Direct {
   M_FORWARD,
   M_BACKWARD,
   M_STOP,
   M_TURNRIGHT
} MotorDirect_t;

//State machine

typedef enum FSM {
   STATE_INITIALIZE,
   STATE_LINE_FOLLOWING,
   STATE_PICK_BALL,
   STATE_REVERSE,
   STATE_TURN_RIGHT,
   STATE_DROP_BALL,
   STATE_OUT_LINE,
   STATE_CHECK_POINT,
   STATE_RETURN_TO_START
}RobotState_t;


typedef struct {
    RobotState_t current;
} State_t;

typedef struct {
    int8 S0, S1, S2;      // IR
    int8 PI_state;
    int8 btn_checkpoint;
    int8 ir_last_state;
} Input_t;

typedef struct {
    int32 t_err;        
    int32 t_pickup;      
    int32 t_reverse;       
    int32 t_turnright;
    int32 t_dropball;        
    int32 t_servo_pulse;   
    int32 t_pi;
    int32 t_run;
    int32 t_forward;
} Timing_t;

typedef struct {
    int1 pick_ball;
    int1 drop_ball;
    int1 pick_turn_flag;
    int1 drop_turn_flag;
    int1 round;
    int1 servo_done;
    int1 forward_flag;
} Flags_t;

typedef struct {
   State_t state;
   Input_t input;
   Timing_t time;
   Flags_t flag;
} RobotContext_t;


typedef enum IR {
   IR_LEFT,
   IR_CENTER,
   IR_RIGHT
}IR_t;

extern volatile RobotContext_t ctx;

//PWM variable
extern volatile int8 left_duty, right_duty;
