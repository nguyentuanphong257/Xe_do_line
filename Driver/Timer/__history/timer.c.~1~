#include "timer.h"

/*************************************************
                GLOBAL VARIABLE
**************************************************/

volatile unsigned int32 g_systemTick = 0;

/*************************************************
                TIMER0
**************************************************/

void Timer0_Init(void)
{
    setup_timer_0(
        RTCC_INTERNAL |
        RTCC_DIV_256
    );

    set_timer0(0);
}

/*************************************************
                TIMER1
**************************************************/

void Timer1_Init(void)
{
    setup_timer_1(
        T1_INTERNAL |
        T1_DIV_BY_8
    );

    set_timer1(0);
}

/*************************************************
                RESET TICK
**************************************************/

void Timer_ResetTick(void)
{
    g_systemTick = 0;
}

/*************************************************
                GET TICK
**************************************************/

unsigned int32 Timer_GetTick(void)
{
    return g_systemTick;
}
