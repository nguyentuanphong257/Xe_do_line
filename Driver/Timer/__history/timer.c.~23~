volatile int8 pwm_motor_count = 0;

void timer0_init (){
   setup_timer_0(T0_INTERNAL | T0_DIV_16);
   set_timer0(65536 - 500);  //500.2us = 1ms
   clear_interrupt(INT_TIMER0);
   enable_interrupts(INT_TIMER0);
}

void timer1_init (){
   setup_timer_1(T1_INTERNAL | T1_DIV_BY_8);
   set_timer1(65536 - 10);  //10.1us = 10us => Ftimer = 100kHz
   clear_interrupt(INT_TIMER1);
   enable_interrupts(INT_TIMER1);
}

void timer0_isr(){
   set_timer0(65536 - 500); //500.2us = 1ms
   S[IR_RIGHT] = input(IR0_SENSOR);
   S[IR_CENTER] = input(IR1_SENSOR);
   S[IR_LEFT] = input(IR2_SENSOR);
   PI = input(PI_SENSOR);
   button_start = input(BUTTON1);
   button_check = input(BUTTON2);
   if (S[IR_LEFT] == LINE_WHITE && S[IR_CENTER] == LINE_WHITE && S[IR_RIGHT] == LINE_WHITE) 
   {
      t_err++;
   } else t_err = 0;
   switch (state) 
   {
      case PICK_BALL:
         t_pickup++;
         break;
      case REVERSE:
         t_reverse++;
         break;
      case DROP_BALL:
         t_dropball++;
         break;
      default:
         t_pickup = 0;
         t_reverse = 0;
         t_dropball = 0;
   }
   if (PI == PI_BLOCKED){
      t_PI++;
   } else t_PI = 0;
}

void timer1_isr(){
   set_timer0(65536 - 10);
   pwm_motor_count++;
   if (pwm_motor_count >= 10)  //Fpwm_motor = 100kHz /10 = 10kHz
   {
      pwm_motor_count = 0;
   }
   output_bit(Motor1, pwm_motor_count < left_duty);
   output_bit(Motor2, pwm_motor_count < right_duty);
}



