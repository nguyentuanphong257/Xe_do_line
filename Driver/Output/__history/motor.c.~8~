#include <config.h>

void Motor_Init(void)
{
    output_low(ANT1);
    output_low(ANT2);

    output_low(BNT1);
    output_low(BNT2);

    left_duty  = 0;
    right_duty = 0;
}

void Motor_direct(MotorDirect_t direct){
   switch(direct)
   {
      case M_FORWARD: 
         output_high(ANT1);
         output_low(ANT2);
         output_high(BNT1);
         output_low(BNT2);
         break;
       case M_BACKWARD:
         output_low(ANT1);
         output_high(ANT2);
         output_low(BNT1);
         output_high(BNT2);
         break;
       case M_TURNRIGHT:
         output_high(ANT1);
         output_low(ANT2);
         output_low(BNT1);
         output_high(BNT2);
         break;
       default:
         output_low(ANT1);
         output_low(ANT2);
         output_low(BNT1);
         output_low(BNT2);
   }
}

