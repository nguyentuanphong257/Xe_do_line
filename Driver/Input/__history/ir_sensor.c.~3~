#include "ir_sensor.h"

void IR_Sensor_Init(void)
{
}

LineState_t IR_ReadState(void)
{
    if(GPIO_ReadPin(IR1)==0 && GPIO_ReadPin(IR2)==0)
    {
        return LINE_CENTER;
    }

    else if(GPIO_ReadPin(IR1)==0 && GPIO_ReadPin(IR2)==1)
    {
        return LINE_RIGHT;
    }

    else if(GPIO_ReadPin(IR1)==1 && GPIO_ReadPin(IR2)==0)
    {
        return LINE_LEFT;
    }

    return LINE_LOST;
}
