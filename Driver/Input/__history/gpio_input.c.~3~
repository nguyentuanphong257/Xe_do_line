#include "../../Config/config.h"

/*************************************************
                INIT
    PORTA: IR1, IR2, IR3, PI  -> input
    PORTB: BUTTON1, BUTTON2   -> input
**************************************************/

void GPIO_Input_Init(void)
{
    set_tris_a(0b00001111);
    set_tris_b(0b00000011);
}

/*************************************************
                READ PIN
**************************************************/

int1 GPIO_ReadPin(int8 pin)
{
    return input(pin);
}
