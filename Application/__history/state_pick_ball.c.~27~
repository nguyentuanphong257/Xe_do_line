#include "main.h"

void Function_PickBall(RobotContext_t *ctx)
{
  // printf("Pick ball\n");
    Motion_Stop();

    if(ctx->time.t_pickup > pickup_timeout)
    {
        ctx->flag.pick_ball = 1;
        ctx->time.t_pickup = 0;
        ctx->state.current = STATE_REVERSE;
        LED_Red_Off();
        return;
    } 
    LED_Red_Toggle();
    delay_ms(50);
}
