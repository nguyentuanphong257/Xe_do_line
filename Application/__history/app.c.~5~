#include "Config/config.h"

void App_Init(void)
{
    // Driver Layer init
    GPIO_Input_Init();
    IR_Sensor_Init();
    PI_Sensor_Init();
    Button_Init();
    LED_Init();
    Motor_Init();
    Servo_Init();

    Timer0_Init();
    Timer1_Init();
    Interrupt_Init();

    //  Application Layer init
    RobotContext_Init(&ctx);
    FSM_Init(&ctx);
}

void RobotContext_Init(RobotContext_t *ctx)
{
    // ---- State ----
    ctx->state.current = STATE_INITIALIZE;

    // ---- Flags ----
    ctx->flag.pick_ball  = 0;
    ctx->flag.pick_turn_flag = 0;
    ctx->flag.drop_ball  = 0;
    ctx->flag.drop_turn_flag = 0;
    ctx->flag.round = 0;
    ctx->flag.servo_done = 0;

    // ---- Input (snapshot cam bien) ----
    ctx->input.S0 = 0;
    ctx->input.S1 = 0;
    ctx->input.S2 = 0;
    ctx->input.PI_state       = 0;
    ctx->input.btn_checkpoint = 0;
    ctx->input.btn_start      = 0;

    // ---- Timing ----
    ctx->time.t_dropball      = 0;
    ctx->time.t_err           = 0;
    ctx->time.t_forward       = 0;
    ctx->time.t_pi            = 0;
    ctx->time.t_pickup        = 0;
    ctx->time.t_reverse       = 0;
    ctx->time.t_run           = 0;
    ctx->time.t_servo_pulse   = 0;
    ctx->time.t_turnright     = 0;
}
