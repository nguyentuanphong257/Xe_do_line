#include "Config/config.h"


void State_TurnRight(RobotContext_t *ctx)
{
   Motion_TurnRight();

   if(ctx->time.t_turnright < TURNRIGHT_MIN_TIME)
   {
       return;
   }
   
   if (ctx->input.S0 == 1 && ctx->input.S1 == 1 && ctx->input.S2 == 1)
   {
      if (ctx->time.t_err > LINE_ERR_TIMEOUT)
      {
         ctx->state.current = STOP;
      } else return;
   } 
   else if (ctx->flag.drop_ball == 1 && ctx->flag.round == 0)
      ctx->state.current = RETURN_TO_START;
   else if ((ctx->flag.drop_ball == 0) || (ctx->flag.drop_ball == 1 && ctx->flag.round == 1))
      ctx->state.current = LINE_FOLLOWING;
