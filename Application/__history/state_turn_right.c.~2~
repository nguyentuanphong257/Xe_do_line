#include "Config/config.h"


void State_TurnRight(RobotContext_t *ctx)
{
    Motion_TurnRight();

    if(!Timing_IsTimeout(ctx->t_reverse, TURNRIGHT_MIN_TIME))
    {
        // Chua du thoi gian re toi thieu -> tiep tuc re
        return;
    }

    // Da re du toi thieu -> kiem tra da bat lai line chua
    if(ctx->S0 == 1)
    {
        Motion_Stop();
        ctx->turned_flag = 1;
        ctx->last_state = ctx->state;

        if(ctx->drop_ball == 1)
        {
            // Vua do bi xong, da bat lai line -> ve tram
            ctx->state = STATE_RETURN_TO_START;
        }
        else if(ctx->round == 0)
        {
            // Moi lay bi lan 1 -> di lay bi lan 2
            ctx->round = 1;
            ctx->state = STATE_LINE_FOLLOW;
        }
        else
        {
            // Da lay du 2 lan bi -> di den tram do bi
            ctx->state = STATE_LINE_FOLLOW;
        }
    }
    // Neu chua thay lai line (S0 == 0) thi tiep tuc re them o vong lap sau
}
