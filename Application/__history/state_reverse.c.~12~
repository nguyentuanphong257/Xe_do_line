#include "main.h"


void Function_Reverse(RobotContext_t *ctx)
{
   printf("Reverse");
    Motion_Backward(5,5);

    if(ctx->time.t_reverse > REVERSE_TIMEOUT)
    {
        Motion_Stop();
        ctx->state.current = STATE_TURN_RIGHT;
        return;
    }
    if (ctx->time.t_err > LINE_ERR_TIMEOUT)
      {
         ctx->state.current = STATE_STOP;
         return;
      }
}
