#include "../../Config/config.h"

/*************************************************
    STATE: DROP_BALL

    Dung servo mo nap hop, bi tu lan vao hop
    (khong can dieu khien them), roi dong nap lai.
**************************************************/

void State_DropBall(RobotContext_t *ctx)
{
    Motion_Stop();

    if(ctx->servo_flag == 0)
    {
        // Mo nap hop lan dau tien vao state nay
        ServoService_Rotate(90);
        ctx->servo_flag = 1;
        ctx->t_servopulse = 0;
        return;
    }

    if(Timing_IsTimeout(ctx->t_servopulse, PICKUP_TIMEOUT))
    {
        // Du thoi gian de bi lan het vao hop -> dong nap lai
        ServoService_Rotate(0);
        ctx->servo_flag = 0;
        ctx->drop_ball  = 1;

        ctx->last_state = ctx->state;
        ctx->state = STATE_REVERSE;
    }
}
