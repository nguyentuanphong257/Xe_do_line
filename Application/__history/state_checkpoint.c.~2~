#include "Config/config.h"


void State_Checkpoint(RobotContext_t *ctx)
{
    if(ctx->drop_ball == 1)
    {
        // Da do bi xong -> tiep tuc hanh trinh ve tram
        ctx->state = ctx->turned_flag ? STATE_RETURN_TO_START : STATE_TURN_RIGHT;
    }
    else if(ctx->pick_ball == 1)
    {
        // Da lay bi nhung chua re/quay dau xong
        ctx->state = ctx->turned_flag ? STATE_LINE_FOLLOW : STATE_TURN_RIGHT;
    }
    else
    {
        // Chua lay bi lan nao -> quay lai do line tu dau
        ctx->state = STATE_LINE_FOLLOW;
    }

    ctx->last_state = STATE_CHECKPOINT;
    LED_Green_On();
}
