....................  
.................... #fuses INTRC_IO, NOWDT, NOLVP, NOBROWNOUT 
.................... #use delay(internal=32MHz)     //Fosc = 32MHz 
....................  
.................... //#use rs232(baud=9600, xmit=PIN_C6, rcv=PIN_C7) 
....................  
.................... //define GPIO PIN_OUT 
.................... #define     IR0_SENSOR        PIN_C1      //phai 
.................... #define     IR1_SENSOR        PIN_C2      //giua 
.................... #define     IR2_SENSOR        PIN_C4      //trai 
.................... #define     PI_SENSOR         PIN_A3 
.................... #define     BUTTON            PIN_C6 
.................... #define     MOTOR1            PIN_C7 
.................... #define     MOTOR2            PIN_B5 
.................... #define     SERVO             PIN_A2 
.................... #define     LED_RED           PIN_A0 
.................... #define     LED_GREEN         PIN_A1 
.................... #define     ANT2              PIN_B0 
.................... #define     ANT1              PIN_B1 
.................... #define     BNT2              PIN_B3 
.................... #define     BNT1              PIN_B4 
.................... #define     STBY              PIN_B2 
....................  
.................... #define     LINE_BLACK              1 
.................... #define     LINE_WHITE              0 
.................... #define     PI_BLOCKED              1 
.................... #define     PI_UNBLOCKED            0 
.................... #define     SERVO_PERIOD_TICK       400 
.................... #define     MOTOR_MAX_DUTY          10 
.................... #define     MOTOR_DUTY_FORWARD_3    6 
.................... #define     MOTOR_DUTY_FORWARD_2    2 
.................... #define     MOTOR_DUTY_FORWARD_1    1 
.................... #define     MOTOR_DUTY_BACKWARD     5 
.................... #define     MOTOR_DUTY_TURNRIGHT    4   
.................... #define     PI_CONFIRM_TIME         1000 //1s 
.................... #define     LINE_ERR_TIMEOUT        3000 //1s 
.................... #define     TIME_FORWARD_MAX        50   //0.2s 
.................... #define     TIME_RUN_MAX            3000 //10s 
.................... #define     REVERSE_TIMEOUT         1000//1s    
.................... #define     TURNRIGHT_MIN_TIME      500 //0.5s 
....................  
.................... extern volatile int16 pickup_timeout; 
.................... extern volatile int16 drop_timeout; 
.................... //MOTOR state 
.................... typedef enum Motor_Direct { 
....................    M_FORWARD, 
....................    M_BACKWARD, 
....................    M_STOP, 
....................    M_TURNRIGHT 
.................... } MotorDirect_t; 
....................  
.................... //State machine 
....................  
.................... typedef enum FSM { 
....................    STATE_INITIALIZE, 
....................    STATE_LINE_FOLLOWING, 
....................    STATE_PICK_BALL, 
....................    STATE_REVERSE, 
....................    STATE_TURN_RIGHT, 
....................    STATE_DROP_BALL, 
....................    STATE_OUT_LINE, 
....................    STATE_CHECK_POINT, 
....................    STATE_RETURN_TO_START 
.................... }RobotState_t; 
....................  
....................  
.................... typedef struct { 
....................     RobotState_t current; 
.................... } State_t; 
....................  
.................... typedef struct { 
....................     int8 S0, S1, S2;      // IR 
....................     int8 PI_state; 
....................     int8 btn_checkpoint; 
....................     int8 ir_last_state; 
.................... } Input_t; 
....................  
.................... typedef struct { 
....................     int32 t_err;         
....................     int32 t_pickup;       
....................     int32 t_reverse;        
....................     int32 t_turnright; 
....................     int32 t_dropball;         
....................     int32 t_servo_pulse;    
....................     int32 t_pi; 
....................     int32 t_run; 
....................     int32 t_forward; 
.................... } Timing_t; 
....................  
.................... typedef struct { 
....................     int1 pick_ball; 
....................     int1 drop_ball; 
....................     int1 pick_turn_flag; 
....................     int1 drop_turn_flag; 
....................     int1 round; 
....................     int1 servo_done; 
....................     int1 forward_flag; 
.................... } Flags_t; 
....................  
.................... typedef struct { 
....................    State_t state; 
....................    Input_t input; 
....................    Timing_t time; 
....................    Flags_t flag; 
.................... } RobotContext_t; 
....................  
....................  
.................... typedef enum IR { 
....................    IR_LEFT, 
....................    IR_CENTER, 
....................    IR_RIGHT 
.................... }IR_t; 
....................  
.................... extern volatile RobotContext_t ctx; 
....................  
