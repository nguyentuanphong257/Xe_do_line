.................... void Motion_Forward(int8 left, int8 right) 
.................... { 
....................    output_high(STBY); 
*
009AA:  BCF    F93.2
009AC:  BSF    F8A.2
....................    Motor_Direct(M_FORWARD); 
009AE:  CLRF   x6E
009B0:  RCALL  089E
....................  
....................    Motor_SetLeftDuty(left); 
009B2:  MOVFF  6C,6E
009B6:  RCALL  08F6
....................    Motor_SetRightDuty(right); 
009B8:  MOVFF  6D,6E
009BC:  RCALL  0906
009BE:  RETURN 0
.................... } 
....................  
....................  
.................... void Motion_TurnRight(void) 
.................... { 
....................    output_high(STBY); 
*
00C24:  BCF    F93.2
00C26:  BSF    F8A.2
....................    Motor_Direct(M_TURNRIGHT); 
00C28:  MOVLW  03
00C2A:  MOVWF  x6E
00C2C:  RCALL  089E
....................  
....................    Motor_SetLeftDuty(MOTOR_DUTY_TURNRIGHT); 
00C2E:  MOVLW  04
00C30:  MOVWF  x6E
00C32:  RCALL  08F6
....................    Motor_SetRightDuty(MOTOR_DUTY_TURNRIGHT); 
00C34:  MOVLW  04
00C36:  MOVWF  x6E
00C38:  RCALL  0906
00C3A:  GOTO   0C98 (RETURN)
.................... } 
....................  
....................  
.................... void Motion_Backward(int8 left, int8 right) 
.................... { 
....................    output_high(STBY); 
*
00B9E:  BCF    F93.2
00BA0:  BSF    F8A.2
....................    Motor_Direct(M_BACKWARD); 
00BA2:  MOVLW  01
00BA4:  MOVWF  x6E
00BA6:  RCALL  089E
....................  
....................    Motor_SetLeftDuty(left); 
00BA8:  MOVFF  6B,6E
00BAC:  RCALL  08F6
....................    Motor_SetRightDuty(right); 
00BAE:  MOVFF  6C,6E
00BB2:  RCALL  0906
00BB4:  GOTO   0BC0 (RETURN)
.................... } 
....................  
....................  
.................... void Motion_Stop(void) 
.................... { 
....................    output_high(STBY); 
*
00916:  BCF    F93.2
00918:  BSF    F8A.2
....................    Motor_Direct(M_STOP); 
0091A:  MOVLW  02
0091C:  MOVWF  x6E
0091E:  RCALL  089E
....................  
....................    Motor_SetLeftDuty(0); 
00920:  CLRF   x6E
00922:  RCALL  08F6
....................    Motor_SetRightDuty(0); 
00924:  CLRF   x6E
00926:  RCALL  0906
00928:  RETURN 0
.................... } 
