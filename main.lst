.................... #define     LED_RED           PIN_A0 
.................... #define     LED_GREEN         PIN_A1 
.................... #define     ANT2              PIN_B0 
.................... #define     ANT1              PIN_B1 
.................... #define     BNT2              PIN_B3 
.................... #define     BNT1              PIN_B4 
.................... #define     STBY              PIN_B2 
....................  
.................... #define     LINE_BLACK              1 
.................... #define     LINE_WHITE              0 
.................... #define     PI_BLOCKED              1 
.................... #define     PI_UNBLOCKED            0 
.................... #define     SERVO_PERIOD_TICK       400 
.................... #define     MOTOR_MAX_DUTY          10 
.................... #define     MOTOR_DUTY_FORWARD_3    6 
.................... #define     MOTOR_DUTY_FORWARD_2    2 
.................... #define     MOTOR_DUTY_FORWARD_1    1 
.................... #define     MOTOR_DUTY_BACKWARD     5 
.................... #define     MOTOR_DUTY_TURNRIGHT    4   
