#include "Config/config.h"


void Sensor_Service_Update()
{
    disable_interrupts(INT_TIMER0);
    g_in.S0 = g_S0;
    g_in.S1 = g_S1;
    g_in.S2 = g_S2;
    g_in.PI_state       = g_PI;
    g_in.btn_start       = g_button_start;
    g_in.btn_checkpoint  = g_button_checkpoint;

    enable_interrupts(INT_TIMER0);
}

