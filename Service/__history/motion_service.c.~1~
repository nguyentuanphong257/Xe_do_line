#include "../Config/config.h"

/*************************************************
                FORWARD
**************************************************/

// left/right: duty PWM riêng cho từng bánh (0..PWM_MAX_DUTY) - phục vụ dò line
// (bánh trong cua giảm duty, bánh ngoài cua giữ nguyên)
void Motion_Forward(int8 left, int8 right)
{
    Motor_Direct(DIR_FORWARD);

    Motor_SetLeftDuty(left);
    Motor_SetRightDuty(right);
}

/*************************************************
                TURN RIGHT
**************************************************/

void Motion_TurnRight(void)
{
    Motor_Direct(DIR_TURN_RIGHT);

    Motor_SetLeftDuty(PWM_MAX_DUTY);
    Motor_SetRightDuty(PWM_MAX_DUTY);
}

/*************************************************
                BACKWARD
**************************************************/

void Motion_Backward(void)
{
    Motor_Direct(DIR_BACKWARD);

    Motor_SetLeftDuty(PWM_MAX_DUTY);
    Motor_SetRightDuty(PWM_MAX_DUTY);
}

/*************************************************
                STOP
**************************************************/

void Motion_Stop(void)
{
    Motor_Direct(DIR_STOP);

    Motor_SetLeftDuty(0);
    Motor_SetRightDuty(0);
}
